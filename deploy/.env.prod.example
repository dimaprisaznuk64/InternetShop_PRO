# Production environment — copy to .env.docker and customize
# NEVER commit .env.docker with real secrets!

# PostgreSQL
POSTGRES_DB=internetshop
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backend — generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_KEY
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_STRONG_PASSWORD@postgres:5432/internetshop
REDIS_URL=redis://redis:6379/0
DEBUG=false
CORS_ORIGINS=https://yourdomain.com
ALLOWED_HOSTS=yourdomain.com
BACKEND_PORT=8000

# Frontend
VITE_API_URL=https://yourdomain.com
FRONTEND_PORT=3000
